# 이 파일을 .env 로 복사한 뒤 값을 채우세요: cp .env.example .env
# 세션 쿠키 서명용 비밀값 (아무 긴 문자열)
SECRET=change-me
DB_USER=root
DB_PW=
DB_NAME=shlack
# 선택: DB_HOST(기본 localhost), DB_PORT(기본 3306), PORT(기본 3002)
# 선택: 세션 저장소 Redis 주소. 없으면 메모리에 저장(서버 재시작 시 로그아웃). Docker Compose 에서는 자동 설정됨
REDIS_URL=
# GIF 검색용 GIPHY API 키 (비워두면 GIF 검색 비활성화)
GIPHY_API_KEY=
# 선택: 보안 설정
# - CORS_ORIGIN: 쿠키를 실어 API 를 부를 수 있는 출처 (쉼표 구분). 비우면 개발 모드는 http://localhost:3090, 운영 모드는 같은 출처만
# - COOKIE_SECURE=true: HTTPS 로 서비스할 때 로그인 쿠키를 HTTPS 에서만 보냄
# - TRUST_PROXY=1: nginx 등 프록시 뒤에서 실제 접속 IP 로 요청 수를 셈
# - RATE_LIMIT_PER_MINUTE(기본 600), AUTH_RATE_LIMIT_PER_MINUTE(기본 10, 로그인·회원가입·비밀번호 변경): IP 당 1분 요청 수 제한
CORS_ORIGIN=
COOKIE_SECURE=
TRUST_PROXY=
# 선택: 이메일 (리마인더 시각에 접속해 있지 않은 사람에게 이메일로 알림). SMTP_URL 이 없으면 이메일을 보내지 않음
# 예: SMTP_URL=smtps://아이디:비밀번호@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=
# 이메일 속 메시지 링크에 쓰는 슐랙 주소 (기본 http://localhost:3090)
APP_URL=
# 캘린더 봇 메시지의 시각 표시 시간대 (기본 Asia/Seoul)
APP_TZ=
# 선택: 통화(허들) 연결. 같은 네트워크가 아니면 TURN 서버가 필요할 수 있음 (예: coturn)
# STUN_URL 기본값 stun:stun.l.google.com:19302
STUN_URL=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# 선택: 앱 연동. 운영에서는 이벤트·명령 주소가 사내망(10.x, 192.168.x, localhost 등)이면 보내지 않음. 사내망 앱을 쓰려면 true
APP_ALLOW_PRIVATE_URLS=
